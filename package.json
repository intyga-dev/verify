{
  "name": "@intyga/verify",
  "version": "1.0.0",
  "description": "Independently verify INTYGA approval receipts — confirm a human cryptographically approved exactly the action about to run, with NO INTYGA secret. Zero npm runtime dependencies; optional OpenSSL 3 for timestamps.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intyga-dev/verify.git"
  },
  "homepage": "https://www.intyga.com",
  "bugs": "https://github.com/intyga-dev/verify/issues",
  "keywords": [
    "verification",
    "receipts",
    "webauthn",
    "es256",
    "audit",
    "offline",
    "zero-dependency"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./approval-policy": {
      "types": "./dist/approval-policy.d.ts",
      "import": "./dist/approval-policy.js",
      "default": "./dist/approval-policy.js"
    }
  },
  "files": [
    "dist",
    "!dist/scripts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "generate:parity-vectors": "node --import tsx src/scripts/generate-verifier-parity-vectors.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'src/**/*.test.ts'",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-lines=94 --test-coverage-branches=80 --test-coverage-functions=98 --test-coverage-exclude='../**' --test-coverage-exclude='src/**/*.test.ts' 'src/**/*.test.ts'"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "ajv": "^8.20.0",
    "tsx": "4.23.12",
    "typescript": "^5.9.3"
  }
}
