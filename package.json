{
  "name": "@intyga/verify",
  "version": "0.1.0",
  "description": "Independently verify Intyga approval receipts — confirm a human cryptographically approved exactly the action about to run, with NO Intyga secret. Zero runtime dependencies; inspect it yourself.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'src/**/*.test.ts'",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-lines=94 --test-coverage-branches=80 --test-coverage-functions=98 --test-coverage-exclude='../**' --test-coverage-exclude='src/**/*.test.ts' 'src/**/*.test.ts'"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "ajv": "^8.20.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
